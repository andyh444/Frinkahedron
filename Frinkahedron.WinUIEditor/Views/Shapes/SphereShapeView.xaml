<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Frinkahedron.WinUIEditor.Views.Shapes.SphereShapeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Frinkahedron.WinUIEditor.Views.Shapes"
    xmlns:vm="using:Frinkahedron.WinUIEditor.ViewModels"
    xmlns:gtvm="using:Frinkahedron.WinUIEditor.ViewModels.GameTemplateViewModels"
    xmlns:svm="using:Frinkahedron.WinUIEditor.ViewModels.GameTemplateViewModels.Shapes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:DataType="svm:SphereShapeViewModel"
    mc:Ignorable="d">

    <Grid ColumnDefinitions="Auto,Auto">
        <TextBlock Grid.Column="0" Text="Radius"/>
        <NumberBox Grid.Column="1" Value="{Binding Radius, Mode=TwoWay}"/>
    </Grid>
</UserControl>
